{
  "name": "ergocapture",
  "version": "0.1.0",
  "private": true,
  "description": "Camera-based ergonomic posture analysis: pose estimation in the browser with RULA, REBA, OWAS, NIOSH, OCRA, Strain Index, ISO 11226 / EN 1005-4, reach and anthropometry.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/patch-rtmlib.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "docx": "^9.8.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rtmlib-ts": "^0.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@mediapipe/tasks-vision": "$@mediapipe/tasks-vision",
    "rtmlib-ts": {
      "onnxruntime-web": "1.24.3"
    },
    "@huggingface/transformers": {
      "onnxruntime-node": "file:./stubs/onnxruntime-node",
      "sharp": "file:./stubs/sharp"
    }
  }
}
